{
    "family": "smartshop-frontend-task",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "smartshop-frontend",
            "image": "://amazonaws.com",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}

